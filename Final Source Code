    window.setFramerateLimit(60);

    std::srand(static_cast<unsigned>(std::time(nullptr)));

    // LOAD FONT
    sf::Font font;

    if (!font.openFromFile("C:/Windows/Fonts/arial.ttf"))
    {
        return -1;
    }

    // GAME STATES
    bool startMenu = true;
    bool gameOver = false;
    bool paused = false;

    // BIRD BODY
    sf::CircleShape bird(22);
