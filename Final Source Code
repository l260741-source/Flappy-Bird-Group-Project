    // RIGHT TREE
    sf::RectangleShape treeTrunk3;
    treeTrunk3.setSize({15, 65});
    treeTrunk3.setPosition({735, 390});
    treeTrunk3.setFillColor(sf::Color(120, 75, 35));

    sf::ConvexShape tree3(3);
